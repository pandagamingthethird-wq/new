# recovery.fstab — Tecno Spark Go 2023, BF7
#
# Two classes of entry on this device, both confirmed during your mount
# debugging:
#   1. Raw by-name nodes (/system_root, /vendor, /system_ext, /product) —
#      these mount fine via the Mount menu using raw block device paths.
#   2. Dynamic/super-partition logical nodes (/system_image, etc.) — these
#      previously failed with "Invalid Argument" because the "logical"
#      flag was present but BOARD_SUPER_PARTITION_SIZE/BOARD_MAIN_SIZE in
#      BoardConfig.mk were still placeholder text. Fixed there; this fstab
#      keeps the "logical" flag so TWRP creates the device-mapper node
#      before attempting mount.

/boot              emmc     /dev/block/bootdevice/by-name/boot
/recovery          emmc     /dev/block/bootdevice/by-name/recovery
/misc              emmc     /dev/block/bootdevice/by-name/para
/metadata          ext4     /dev/block/bootdevice/by-name/md_udc

/system_root       ext4     /dev/block/bootdevice/by-name/system
/vendor            ext4     /dev/block/bootdevice/by-name/vendor
/system_ext        ext4     /dev/block/bootdevice/by-name/system_ext
/product           ext4     /dev/block/bootdevice/by-name/product

/system_image      ext4     /dev/block/mapper/system          logical
/vendor_image      ext4     /dev/block/mapper/vendor          logical
/product_image     ext4     /dev/block/mapper/product         logical
/system_ext_image  ext4     /dev/block/mapper/system_ext      logical

/data              f2fs     /dev/block/bootdevice/by-name/userdata   length=-16384
# ^ f2fs + Trustonic TEE/Keymaster 4.1 encrypted. FBE decrypt in recovery
# is NOT currently functional — see open issue re: mcDrvDaemon/TEE daemon
# missing from the recovery ramdisk. Mounting unencrypted or with a
# working decrypt stack both still require that fixed first.

/cache             ext4     /dev/block/bootdevice/by-name/cache
/external_sd       vfat     /dev/block/mmcblk1p1    /devices/platform/bootdevice/by-name/sdcard1  flags=display="Micro SD";storage;wipeingui;removable
/usb-otg           vfat     /dev/block/sda1         /devices/platform/bootdevice/by-name/usbotg    flags=display="USB OTG";storage;wipeingui;removable
